<div class="pagination-bar">
  <ul class="pagination">
    <% if (page.prev) { %>

      <a class="mr" href="<%- url_for(page.prev_link) %>">
        <span>⬅️</span>
        <span>Lebih baru</span>
      </a>

      <% } %>
        <% if (page.next) { %>

          <a class="" href="<%- url_for(page.next_link) %>">
            <span>Lebih lama</span>
            <span>➡️</span>
          </a>

          <% } %>
  </ul>
</div>